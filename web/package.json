{
  "name": "escalate-web",
  "version": "0.1.0",
  "private": true,
  "description": "Escalate web app: a Next.js front end on the Escalate API.",
  "license": "MIT",
  "scripts": {
    "prebuild": "node scripts/gen-locales.mjs",
    "build": "next build",
    "build:demo": "NEXT_PUBLIC_DEMO_STATIC=true next build",
    "prebuild:demo": "node scripts/gen-locales.mjs",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "predev": "node scripts/gen-locales.mjs",
    "dev": "next dev --port 3000",
    "prelint": "node scripts/gen-locales.mjs",
    "lint": "eslint . --max-warnings=0",
    "screenshots": "playwright test --project=screenshots",
    "start": "next start --port 3000",
    "test": "node --test tests/*.test.mts",
    "test:e2e": "playwright test",
    "pretypecheck": "node scripts/gen-locales.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
